[Unit]
Description=khanh.design course application API
After=network.target

[Service]
Type=simple
User=khanh-course
Group=khanh-course
StateDirectory=khanh-course
StateDirectoryMode=0700
WorkingDirectory=/usr/local/lib/khanh-course
ExecStart=/usr/bin/python3 /usr/local/lib/khanh-course/course_application_server.py --host 127.0.0.1 --port 8092 --store /var/lib/khanh-course/applications.json --state-dir /var/lib/khanh-course --rate-limit 5 --rate-window 60
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
